# ---- Database (Supabase) ----
# Use the transaction pooler connection string (port 6543) for Vercel.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ---- App ----
# Public URL of the app. Used for links in e-mails.
APP_URL="http://localhost:5173"
# Set to false only for local development over plain http in browsers that reject
# Secure cookies on localhost (e.g. Safari).
COOKIE_SECURE="true"
SESSION_TTL_DAYS="30"
APP_TIMEZONE="Asia/Tokyo"

# ---- E-mail (Resend) ----
# When unset, e-mails are written to the API log instead of being sent.
RESEND_API_KEY=""
MAIL_FROM="Beyond TODO. <noreply@your-domain.example>"

# ---- AI insights (Gemini) ----
# When unset, rule-based insights are used.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ---- Vercel Cron ----
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron endpoints.
CRON_SECRET=""
