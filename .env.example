# ---- Environment ----
# local      : notifications are not sent (logged to the API output instead)
# production : sends e-mail via Resend, forces Secure cookies, and fails at startup
#              if DATABASE_URL / RESEND_API_KEY / MAIL_FROM / CRON_SECRET / APP_URL
#              (https) are missing.
# On Vercel this is set to production automatically (VERCEL_ENV is present), so it
# does not need to be configured there.
APP_ENV="local"

# ---- Database (Supabase) ----
# Use the transaction pooler connection string (port 6543) for Vercel.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ---- App ----
# Public URL of the app. Used for links in e-mails.
APP_URL="http://localhost:5173"
# Local only (ignored in production, which always uses Secure cookies). Set to false
# for plain http in browsers that reject Secure cookies on localhost (e.g. Safari).
COOKIE_SECURE="true"
SESSION_TTL_DAYS="30"
APP_TIMEZONE="Asia/Tokyo"

# ---- E-mail (Resend) ----
# Used only when APP_ENV=production (required there).
RESEND_API_KEY=""
MAIL_FROM="Beyond TODO. <noreply@your-domain.example>"

# ---- AI insights (Gemini) ----
# When unset, rule-based insights are used.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ---- Vercel Cron ----
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron endpoints.
CRON_SECRET=""
