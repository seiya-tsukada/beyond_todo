# ---- Environment ----
# local      : e-mails are logged by default (MAIL_BACKEND=log)
# production : forces Secure cookies. Uses Supabase / Resend when DATABASE_URL /
#              RESEND_API_KEY are set, otherwise falls back to mock / log, so a
#              fresh Vercel deployment starts with no variables set.
# On Vercel this is set to production automatically (VERCEL_ENV is present), so it
# does not need to be configured there.
APP_ENV="local"

# ---- Stand-ins for external services ----
# DATA_BACKEND: postgres (default) | mock  -- mock serves static sample data, no DB needed
#   (log in with demo@example.com / demo-password; writes are not stored)
# MAIL_BACKEND: resend (production default) | log (local default) -- log only prints e-mails
# Production default: postgres if DATABASE_URL is set (else mock), resend if
# RESEND_API_KEY is set (else log).
DATA_BACKEND="postgres"
MAIL_BACKEND="log"

# ---- Database (Supabase) ----
# Use the transaction pooler connection string (port 6543) for Vercel.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# ---- App ----
# Public URL of the app. Used for links in e-mails. On Vercel it defaults to the
# deployment's URL when unset.
APP_URL="http://localhost:5173"
# Local only (ignored in production, which always uses Secure cookies). Set to false
# for plain http in browsers that reject Secure cookies on localhost (e.g. Safari).
COOKIE_SECURE="true"
SESSION_TTL_DAYS="30"
APP_TIMEZONE="Asia/Tokyo"

# ---- E-mail (Resend) ----
# Used only when MAIL_BACKEND=resend (required there).
RESEND_API_KEY=""
MAIL_FROM="Beyond TODO. <noreply@your-domain.example>"

# ---- AI insights (Gemini) ----
# When unset, rule-based insights are used.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ---- Vercel Cron ----
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron endpoints.
CRON_SECRET=""
